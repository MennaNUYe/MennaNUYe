# Website and contact
WEBSITE_URL=https://example.com
CONTACT_NUMBERS=+251900000000,+251911111111
DELIVERY_LOCATIONS=Addis Ababa,Adama
PAYMENT_METHODS=Cash,Bank Transfer,Telebirr

# WooCommerce API
WC_BASE_URL=https://example.com
WC_CONSUMER_KEY=ck_xxx
WC_CONSUMER_SECRET=cs_xxx

# MySQL/WordPress
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=change-me
WP_TABLE_PREFIX=wp_

# Supplier sources
SUPPLIER_CSV_PATH=data/supplier_products.csv
SUPPLIER_URLS=
MAX_PRICE_DROP_PCT=0.90
MAX_PRICE_INCREASE_PCT=2.00

# Telegram and Meta
TELEGRAM_BOT_TOKEN=123456:token
TELEGRAM_CHANNEL_ID=@your_channel
TELEGRAM_ADMIN_CHAT_ID=123456789
META_PAGE_ID=123456789
META_ACCESS_TOKEN=EAAB...

# LLM/Ollama or cloud-compatible endpoint
LLM_PROVIDER=ollama
LLM_API_URL=http://127.0.0.1:11434/api/generate
LLM_MODEL=gemma3:4b
LLM_API_KEY=

# Storage and monitoring
AUTOMATION_LOG_FILE=automation.log
DATA_DIR=data
MEDIA_DIR=media
BACKUP_DIR=backups
REMOTE_BACKUP_TARGET=remote:catalog-backups
MONITOR_URLS=https://example.com,https://example.com/shop
